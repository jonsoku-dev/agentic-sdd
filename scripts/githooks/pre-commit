#!/bin/sh
# Regenerate llms.txt when docs changed and run the fast test suite.
set -e
root="$(git rev-parse --show-toplevel)"
cd "$root"
if git diff --cached --name-only | grep -q -E '\.(md|mdc)$|^scripts/build_llms\.py$'; then
  python3 scripts/build_llms.py >/dev/null
  git add llms.txt llms-full.txt
fi
if git diff --cached --name-only | grep -q -E '^(SKILL\.md|LICENSE|package\.json|references/|templates/|visualizer/|scripts/|hosts/claude/)'; then
  python3 scripts/build_plugins.py >/dev/null
  git add plugins .claude-plugin
fi
python3 -m unittest discover -s tests -p 'test_*.py' >/dev/null 2>&1 || { echo "pre-commit: tests failed; run python3 -m unittest discover -s tests" >&2; exit 1; }
python3 -m unittest discover -s hosts/cursor/hooks/agentic-sdd-continue -p 'test_*.py' >/dev/null 2>&1 || { echo "pre-commit: cursor hook tests failed" >&2; exit 1; }
