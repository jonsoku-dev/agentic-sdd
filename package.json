{
  "name": "agentic-sdd",
  "version": "1.5.0",
  "description": "Spec-Driven Development that finishes: GitHub Spec Kit end to end on Claude Code, Codex, Cursor, and Grok Build, with pstack inside every phase and REA closeout evidence.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonsoku-dev/agentic-sdd.git"
  },
  "homepage": "https://github.com/jonsoku-dev/agentic-sdd#readme",
  "bugs": "https://github.com/jonsoku-dev/agentic-sdd/issues",
  "keywords": [
    "spec-kit",
    "spec-driven-development",
    "claude-code",
    "codex",
    "cursor",
    "grok",
    "pstack",
    "agent-skills"
  ],
  "bin": {
    "agentic-sdd": "bin/agentic-sdd.js"
  },
  "files": [
    "bin/",
    "SKILL.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "llms.txt",
    "pins.json",
    "install.sh",
    "agents/",
    "evals/",
    "hosts/",
    "personas/",
    "references/",
    "scripts/",
    "templates/",
    "visualizer/",
    "docs/BENCHMARKS.md",
    "!**/__pycache__/",
    "!**/*.pyc"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "scripts": {
    "test": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "setup": "node bin/agentic-sdd.js",
    "check-deps": "node bin/agentic-sdd.js check-deps"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
